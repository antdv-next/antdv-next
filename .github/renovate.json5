{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "enabledManagers": ["github-actions"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": [
        "docker",
        "container",
        "service",
        "github-runner",
        "uses-with"
      ],
      "enabled": false
    }
  ]
}
